{
  "name": "Zapto do OpenStreetMap Brasil",
  "short_name": "Zapto",
  "lang": "pt-br",
  "description": "Coloque seu empreendimento no mapa!.",
  "categories": ["mapas", "educação"],
  "intent_filters": 
  {
    "scope_url_scheme": "https",
    "scope_url_host": "zapto.openstreetmap.org.br",
    "scope_url_path": "/"
  },
  "start_url": "zapto.openstreetmap.org.br",
  "display": "fullscreen",
  "scope": "/",
  "orientation": "portrait",
  "background_color": "#3740ff",
  "theme_color": "#2f3030",
  "icons": [
    {
      "src": "img/192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "img/foto512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
    "capture_links": "existing_client_event",
    "url_handlers": [
    {
      "origin": "https://zapto.openstreetmap.org.br"
    }
  ],
   "protocol_handlers": [
    {
      "protocol": "web+site",
      "url": "/?type=%s"
    }
  ]
}
